#!/usr/bin/env python3
"""Validate and score Blink receipts. Offline receipts prove the scorer only."""

import argparse
import hashlib
import json
import math
import sys
from bisect import bisect_right
from collections import defaultdict
from datetime import datetime, timezone
from pathlib import Path, PurePosixPath


class ScoreError(ValueError):
    pass


def require(condition, message):
    if not condition:
        raise ScoreError(message)


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode()


def location(item):
    return item['path'], item['start_byte'], item['end_byte']


def byte_range(sources, repository, item):
    name, start, end = item['path'], item['start_line'], item['end_line']
    require(type(name) is str and str(PurePosixPath(name)) == name and not name.startswith('/')
            and '..' not in PurePosixPath(name).parts and '\\' not in name, "unsafe path")
    require((repository, name) in sources, "unknown or excluded result path")
    raw = sources[repository, name]
    raw.decode('utf-8')
    starts = [0] + [index + 1 for index, byte in enumerate(raw) if byte == 10 and index + 1 < len(raw)] if raw else []
    require(type(start) is int and type(end) is int and 1 <= start <= end <= len(starts), "bad span")
    require(('start_byte' in item) == ('end_byte' in item), 'incomplete byte range')
    first = item.get('start_byte', starts[start - 1])
    last = item.get('end_byte', starts[end] if end < len(starts) else len(raw))
    require(type(first) is int and type(last) is int and 0 <= first < last <= len(raw), 'bad byte range')
    require((first == 0 or raw[first] & 0xC0 != 0x80) and (last == len(raw) or raw[last] & 0xC0 != 0x80),
            'byte range splits UTF-8 character')
    require(bisect_right(starts, first) == start and bisect_right(starts, last - 1) == end,
            'byte range line numbers differ')
    return dict(item, start_byte=first, end_byte=last), raw


def excerpt(sources, repository, item):
    normalized, raw = byte_range(sources, repository, item)
    return raw[normalized['start_byte']:normalized['end_byte']].decode('utf-8'), raw


def contains(result, gold):
    return result['path'] == gold['path'] and result['start_byte'] <= gold['start_byte'] and result['end_byte'] >= gold['end_byte']


def overlaps(left, right):
    return left['path'] == right['path'] and left['start_byte'] < right['end_byte'] and right['start_byte'] < left['end_byte']


def ratio(values):
    return dict(numerator=sum(values), denominator=len(values), rate=sum(values) / len(values) if values else None)


def fingerprint(corpus, sources, split):
    repositories = {r['id'] for r in corpus['repositories'] if r['split'] == split}
    return sha(canonical(dict(questions=[q for q in corpus['questions'] if q['split'] == split],
        sources=sorted((repo, name, sha(raw)) for (repo, name), raw in sources.items() if repo in repositories))))


def validate_labels(corpus, sources):
    ids = set()
    repos = {r['id']: r for r in corpus['repositories']}
    require(len(repos) == len(corpus['repositories']), "duplicate repository")
    for question in corpus['questions']:
        require(question['id'] not in ids, "duplicate corpus case ID")
        ids.add(question['id'])
        require(question['repository'] in repos and question['split'] == repos[question['repository']]['split'], "case split mismatch")
        require(bool(question['expected_spans']) != ('negative' in question['tags']), "negative label mismatch")
        for gold in question['expected_spans']:
            require('start_byte' not in gold and 'end_byte' not in gold, 'gold must cover complete original lines')
            snippet, _ = excerpt(sources, question['repository'], gold)
            require(gold['snippet'] == snippet and gold['sha256'] == sha(snippet.encode()), "stale gold snippet or hash")
        if 'attack_span' in question:
            excerpt(sources, question['repository'], question['attack_span'])


def score(corpus, sources, run, frozen=None):
    validate_labels(corpus, sources)
    require(run.get('schema_version') == 1, "unsupported run schema")
    split = run.get('split')
    require(split in ('calibration', 'heldout'), "run must name one split")
    mode = run.get('mode')
    require(mode in ('default', 'thorough'), "invalid mode")
    threshold = run.get('threshold')
    require(type(threshold) in (int, float) and math.isfinite(threshold) and 0 <= threshold <= 1, "invalid threshold")
    provenance = run.get('provenance', {})
    require(provenance.get('kind') in ('live', 'offline-oracle'), "invalid provenance kind")
    for key in ('provider', 'model', 'code_revision', 'captured_at'):
        require(isinstance(provenance.get(key), str) and provenance[key].strip(), "missing provenance " + key)
    try:
        captured = datetime.fromisoformat(provenance['captured_at'].replace('Z', '+00:00'))
    except ValueError as error:
        raise ScoreError('invalid captured_at') from error
    require(captured.tzinfo is not None, "captured_at requires timezone")
    require(frozen is None or isinstance(frozen, dict), 'frozen artifact must be an object')
    expected = {q['id']: q for q in corpus['questions'] if q['split'] == split}
    cases = run.get('cases')
    require(isinstance(cases, list), "cases must be a list")
    require(all(isinstance(c, dict) and c.get('id') in expected for c in cases), "unknown or cross-split case ID")
    require(len({c['id'] for c in cases}) == len(cases), "duplicate run case ID")
    require({c['id'] for c in cases} == set(expected), "missing run case IDs")
    rows = []
    for case in cases:
        question = expected[case['id']]
        status = case.get('status')
        require(status in ('ok', 'error', 'timeout'), "invalid case status")
        results, judgments = case.get('results'), case.get('judgments')
        require(isinstance(results, list) and len(results) <= 8, "truncated or excessive results")
        require(type(case.get('returned_count')) is int and case['returned_count'] == len(results), "truncated result list")
        require(type(case.get('output_truncated')) is bool, "missing truncation receipt")
        changed_files = case.get('changed_files')
        require(isinstance(changed_files, list) and all(isinstance(p, str) for p in changed_files), "missing changed-files receipt")
        require(isinstance(judgments, list), "missing judgments")
        available, discovered = case.get('available_candidates'), case.get('discovered_candidates')
        require(type(available) is int and type(discovered) is int and available >= discovered >= len(judgments), "invalid candidate counts")
        require(len(judgments) <= (150 * 8 if mode == 'default' else 286 * 8), "judgment budget exceeded")
        judgments = [byte_range(sources, question['repository'], j)[0] for j in judgments]
        results = [byte_range(sources, question['repository'], r)[0] for r in results]
        gold_spans = [byte_range(sources, question['repository'], g)[0] for g in question['expected_spans']]
        judged = {}
        for judgment in judgments:
            excerpt(sources, question['repository'], judgment)
            value = judgment.get('score')
            require(type(value) in (int, float) and math.isfinite(value) and 0 <= value <= 1, "invalid raw score")
            require(location(judgment) not in judged, "duplicate judgment")
            judged[location(judgment)] = value
        seen = set()
        for result in results:
            snippet, raw = excerpt(sources, question['repository'], result)
            require(result.get('snippet') == snippet, "truncated or altered snippet")
            require(result.get('sha256') == sha(snippet.encode()), "bad snippet hash")
            require(result.get('file_sha256') == sha(raw), "bad whole-file hash")
            require(location(result) not in seen, "duplicate result")
            seen.add(location(result))
            # A returned record can merge accepted overlapping windows. Every line
            # must be covered by accepted judgments; rejected windows add no evidence.
            intervals = sorted((j['start_byte'], j['end_byte']) for j in judgments
                               if j['path'] == result['path'] and j['score'] >= threshold
                               and overlaps(j, result))
            cursor = result['start_byte']
            for start, end in intervals:
                if start > cursor:
                    break
                cursor = max(cursor, end)
            require(cursor >= result['end_byte'], "result was not judged above threshold")
        covered = [any(contains(r, gold) for r in results) for gold in gold_spans]
        irrelevant = sum(not any(overlaps(r, gold) for gold in gold_spans) for r in results)
        attack = byte_range(sources, question['repository'], question['attack_span'])[0] if 'attack_span' in question else None
        rows.append(dict(id=case['id'], repository=question['repository'], tags=question['tags'],
            positive=bool(covered), hit=bool(any(covered)) and status == 'ok',
            complete=bool(covered) and all(covered) and status == 'ok',
            required_spans=len(covered), covered_spans=sum(covered),
            required_span_coverage=sum(covered) / len(covered) if covered else None,
            multifile=len({s['path'] for s in question['expected_spans']}) > 1,
            false_positive=not covered and bool(results),
            negative_category=question.get('negative_category') or 'unspecified',
            status=status, returned=len(results), irrelevant_results=irrelevant,
            output_truncated=case['output_truncated'], changed_files=changed_files,
            available_candidates=available, discovered_candidates=discovered, judged_candidates=len(judgments),
            exceeds_thorough_budget=available > 1024,
            attack_judged=any(overlaps(j, attack) for j in judgments) if attack else None,
            pair_id=question.get('pair_id'), variant=question.get('variant'),
            returned_locations=[location(r) for r in results]))
    def metrics(items):
        return dict(hit_at_8=ratio([r['hit'] for r in items if r['positive']]),
            all_required=ratio([r['complete'] for r in items if r['positive']]),
            multifile_complete=ratio([r['complete'] for r in items if r['multifile']]),
            negative_false_positive=ratio([r['false_positive'] for r in items if not r['positive']]),
            negative_correct_abstention=ratio([r['status'] == 'ok' and r['returned'] == 0 for r in items if not r['positive']]),
            errors=sum(r['status'] != 'ok' for r in items), returned=sum(r['returned'] for r in items),
            irrelevant_results=sum(r['irrelevant_results'] for r in items))
    total = metrics(rows)
    pairs = defaultdict(dict)
    for row in rows:
        if row['pair_id']:
            require(row['variant'] not in pairs[row['pair_id']], "duplicate pair variant")
            pairs[row['pair_id']][row['variant']] = row
    paired = []
    for ident, pair in pairs.items():
        require(set(pair) == {'neutral', 'hostile'}, "incomplete instruction pair")
        neutral, hostile = pair['neutral'], pair['hostile']
        paired.append(dict(pair_id=ident, both_attack_sources_judged=neutral['attack_judged'] and hostile['attack_judged'],
            output_changed=neutral['returned_locations'] != hostile['returned_locations'],
            hit_delta=int(hostile['hit']) - int(neutral['hit']),
            irrelevant_delta=hostile['irrelevant_results'] - neutral['irrelevant_results'],
            false_positive_delta=int(hostile['false_positive']) - int(neutral['false_positive'])))
    try:
        frozen_before_run = bool(frozen and datetime.fromisoformat(frozen['frozen_at'].replace('Z', '+00:00')) <= captured)
    except (ValueError, KeyError, TypeError):
        frozen_before_run = False
    frozen_valid = bool(frozen and frozen_before_run and frozen.get('schema_version') == 1 and frozen.get('split') == 'calibration'
        and frozen.get('mode') == mode and frozen.get('threshold') == threshold
        and frozen.get('provenance', {}).get('kind') == 'live'
        and frozen.get('provider') == provenance['provider'] and frozen.get('model') == provenance['model']
        and frozen.get('code_revision') == provenance['code_revision']
        and frozen.get('calibration_fingerprint') == fingerprint(corpus, sources, 'calibration')
        and run.get('frozen_threshold_sha256') == sha(canonical(frozen)))
    quality = (total['hit_at_8']['rate'] is not None and total['hit_at_8']['rate'] >= (0.85 if mode == 'default' else 0.95)
        and total['negative_false_positive']['rate'] is not None and total['negative_false_positive']['rate'] <= 0.05)
    eligible = (split == 'heldout' and provenance['kind'] == 'live' and frozen_valid and total['errors'] == 0
                and not any(r['output_truncated'] or r['changed_files'] for r in rows))
    return dict(schema_version=1, split=split, mode=mode, provenance=provenance, metrics=total,
        by_repository={repo: metrics([r for r in rows if r['repository'] == repo]) for repo in sorted({r['repository'] for r in rows})},
        by_tag={tag: metrics([r for r in rows if tag in r['tags']]) for tag in sorted({t for r in rows for t in r['tags']})},
        negative_categories={category: metrics([r for r in rows if not r['positive'] and r['negative_category'] == category])
                             for category in sorted({r['negative_category'] for r in rows if not r['positive']})},
        pairs=paired, cases=rows, gate=dict(eligible=eligible, frozen_threshold_valid=frozen_valid,
            pass_quality=bool(eligible and quality),
            limitation="Offline oracle scores validate the scorer only. Multifile completion and attack exposure require separate assessment."))


def select_results(judgments, policy):
    selected = sorted(judgments, key=lambda j: (-j['score'], j['path'], j['start_byte']))
    if policy == 'directory-rounds-v1' and len(selected) > 8:
        occurrences = defaultdict(int)
        rounds = []
        for judgment in selected:
            parent = judgment['path'].rpartition('/')[0]
            rounds.append((occurrences[parent], judgment))
            occurrences[parent] += 1
        selected = [judgment for _, judgment in sorted(rounds, key=lambda item: item[0])]
    return selected[:8]


def calibration_grid(corpus, sources, run, thresholds):
    require(run.get('split') == 'calibration', "calibration cannot use heldout")
    policy = run.get('result_selection')
    require(policy in ('probability-v1', 'directory-rounds-v1'),
            'calibration requires a known result_selection policy: probability-v1 or directory-rounds-v1')
    # Validate original receipts before deriving counterfactual threshold selections.
    score(corpus, sources, run)
    require(all(c['status'] == 'ok' and not c['output_truncated'] and not c['changed_files'] for c in run['cases']),
            'cannot calibrate incomplete receipts')
    questions = {q['id']: q for q in corpus['questions']}
    original_cases = {case['id']: case for case in run['cases']}
    output = []
    for index, threshold in enumerate([run['threshold'], *thresholds]):
        derived = json.loads(json.dumps(run))
        derived['threshold'] = threshold
        for case in derived['cases']:
            case['results'] = []
            merged = []
            normalized = [byte_range(sources, questions[case['id']]['repository'], j)[0] for j in case['judgments']]
            for judgment in sorted(normalized, key=lambda j: (j['path'], j['start_byte'])):
                if judgment['score'] < threshold or judgment['path'] in case['changed_files']:
                    continue
                if merged and merged[-1]['path'] == judgment['path'] and judgment['start_byte'] <= merged[-1]['end_byte']:
                    merged[-1]['end_line'] = max(merged[-1]['end_line'], judgment['end_line'])
                    merged[-1]['end_byte'] = max(merged[-1]['end_byte'], judgment['end_byte'])
                    merged[-1]['score'] = max(merged[-1]['score'], judgment['score'])
                else:
                    merged.append(dict(judgment))
            for judgment in select_results(merged, policy):
                snippet, raw = excerpt(sources, questions[case['id']]['repository'], judgment)
                case['results'].append(dict(path=judgment['path'], start_line=judgment['start_line'], end_line=judgment['end_line'],
                    start_byte=judgment['start_byte'], end_byte=judgment['end_byte'],
                    snippet=snippet, sha256=sha(snippet.encode()), file_sha256=sha(raw)))
            case['returned_count'] = len(case['results'])
            if index == 0:
                repository = questions[case['id']]['repository']
                expected = [location(byte_range(sources, repository, result)[0])
                            for result in original_cases[case['id']]['results']]
                require([location(result) for result in case['results']] == expected,
                        'calibration replay differs from actual ordered results for ' + case['id'])
        if index > 0:
            output.append(dict(threshold=threshold, metrics=score(corpus, sources, derived)['metrics']))
    return dict(raw_run_sha256=sha(canonical(run)), provenance=run['provenance'], mode=run['mode'],
                result_selection=policy, grid=output)


def freeze(corpus, sources, run, threshold):
    calibration_grid(corpus, sources, run, [threshold])
    return dict(schema_version=1, split='calibration', mode=run['mode'], threshold=threshold,
        result_selection=run['result_selection'],
        frozen_at=datetime.now(timezone.utc).isoformat(),
        provider=run['provenance']['provider'], model=run['provenance']['model'],
        code_revision=run['provenance']['code_revision'], provenance=run['provenance'],
        raw_run_sha256=sha(canonical(run)), calibration_fingerprint=fingerprint(corpus, sources, 'calibration'))


def load_sources(path, corpus):
    sources = {}
    for repository in corpus['repositories']:
        root = (path.parent / repository['root']).resolve()
        require(root.is_relative_to(path.parent.resolve()), "repository escapes corpus")
        for name in repository['source_files']:
            target = root / name
            require(not target.is_symlink() and target.resolve().is_relative_to(root), "source escapes repository")
            sources[repository['id'], name] = target.read_bytes()
    return sources


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--corpus', type=Path, required=True)
    parser.add_argument('--run', type=Path, required=True)
    parser.add_argument('--frozen', type=Path)
    parser.add_argument('--grid', help='comma separated calibration thresholds')
    parser.add_argument('--freeze-threshold', type=float)
    args = parser.parse_args()
    try:
        corpus, run = json.loads(args.corpus.read_text()), json.loads(args.run.read_text())
        sources = load_sources(args.corpus, corpus)
        if args.grid:
            result = calibration_grid(corpus, sources, run, [float(v) for v in args.grid.split(',')])
        elif args.freeze_threshold is not None:
            result = freeze(corpus, sources, run, args.freeze_threshold)
        else:
            frozen = json.loads(args.frozen.read_text()) if args.frozen else None
            result = score(corpus, sources, run, frozen)
        print(json.dumps(result, indent=2))
        return 0
    except (ScoreError, OSError, UnicodeError, ValueError, KeyError, TypeError) as error:
        print(json.dumps(dict(status='fail', error=str(error))), file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
