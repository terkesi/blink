#!/usr/bin/env python3
"""Measure local source preparation on a disposable 10,000-file, 50 MiB fixture."""
import argparse
import datetime
import json
import os
from pathlib import Path
import platform
import statistics
import subprocess
import sys
import tempfile
import time

FILES = 10_000
BYTES = 50 * 1024 * 1024


def fixture(root):
    line = b"fn retry_delay(attempt: u32) -> u32 { attempt.min(8) * 100 }\n"
    for index in range(FILES):
        size = BYTES // FILES + int(index < BYTES % FILES)
        path = root / f"group-{index // 100:03}" / f"source-{index:05}.rs"
        path.parent.mkdir(exist_ok=True)
        path.write_bytes((line * (size // len(line) + 1))[:size])


def sample(binary, root, output, name):
    started = time.perf_counter()
    with (output / (name + ".stdout")).open("wb") as stdout, (output / (name + ".stderr")).open("wb") as stderr:
        child = subprocess.Popen([binary, str(root)], stdout=stdout, stderr=stderr)
        _, status, usage = os.wait4(child.pid, 0)
        child.returncode = os.waitstatus_to_exitcode(status)
    wall_ms = (time.perf_counter() - started) * 1000
    if child.returncode != 0:
        raise RuntimeError(f"{name} exited {child.returncode}; see preserved stderr")
    value = json.loads((output / (name + ".stdout")).read_text())
    coverage = value["coverage"]
    assert coverage["complete"], value
    assert coverage["files_included"] == FILES, value
    assert coverage["bytes_included"] == BYTES, value
    assert coverage["bytes_read"] >= BYTES, value
    assert value["windows"] >= FILES and value["candidates"] == 512, value
    return {
        "name": name,
        "status": child.returncode,
        "wall_ms": wall_ms,
        "prepare_ms": value["elapsed_ms"],
        "peak_rss_bytes": usage.ru_maxrss * (1 if sys.platform == "darwin" else 1024),
        "user_seconds": usage.ru_utime,
        "system_seconds": usage.ru_stime,
        "files": coverage["files_included"],
        "bytes": coverage["bytes_included"],
        "windows": value["windows"],
        "candidates": value["candidates"],
    }


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", required=True, type=Path)
    parser.add_argument("--runs", type=int, default=5)
    args = parser.parse_args()
    if args.runs < 5:
        parser.error("at least five runs are required")
    output = args.output.resolve()
    output.mkdir(parents=True, exist_ok=True)
    if any(output.iterdir()):
        parser.error("output must be empty to preserve previous evidence")
    repo = Path(__file__).resolve().parent.parent
    environment = os.environ.copy()
    environment.pop("OPENAI_API_KEY", None)
    command = ["cargo", "build", "--locked", "--release", "--example", "prepare", "--message-format=json"]
    build = subprocess.run(command, cwd=repo, env=environment, capture_output=True, check=False)
    (output / "build.stdout").write_bytes(build.stdout)
    (output / "build.stderr").write_bytes(build.stderr)
    if build.returncode:
        raise RuntimeError("release build failed; inspect build.stderr")
    events = [json.loads(line) for line in build.stdout.splitlines()]
    binary = next(event["executable"] for event in events if event.get("executable") and event.get("target", {}).get("name") == "prepare")
    records = []
    fixtures = []
    passed = False
    metadata = {
        "captured_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        "platform": platform.platform(),
        "cpu_model": subprocess.check_output(["sysctl", "-n", "machdep.cpu.brand_string"], text=True).strip() if sys.platform == "darwin" else platform.processor(),
        "cpu_count": os.cpu_count(),
        "load_average_before": os.getloadavg(),
        "files": FILES,
        "fixture_bytes": BYTES,
        "runs_per_condition": args.runs,
        "cache_policy": "fresh process for every sample; OS file cache uncontrolled; no disk-cold claim",
        "network_requests": 0,
        "code_revision": subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=repo, text=True).strip(),
        "working_tree_dirty": bool(subprocess.check_output(["git", "status", "--porcelain"], cwd=repo)),
        "sample_order": "new fixture, unchanged repeat, changed file; repeat for each trial",
    }
    try:
        for trial in range(args.runs):
            with tempfile.TemporaryDirectory(prefix="blink-benchmark-") as temporary:
                root = Path(temporary)
                fixtures.append(root)
                fixture(root)
                records.append(sample(binary, root, output, f"{trial + 1}-new"))
                records.append(sample(binary, root, output, f"{trial + 1}-warm"))
                changed = root / "group-000" / "source-00000.rs"
                before = changed.read_bytes()
                after = before.replace(b"min(8)", b"min(4)")
                assert before != after and len(before) == len(after)
                changed.write_bytes(after)
                records.append(sample(binary, root, output, f"{trial + 1}-changed"))
        passed = True
    finally:
        metadata.update(passed=passed, failures=0 if passed else 1, samples=records, fixtures_removed=all(not path.exists() for path in fixtures))
        if passed:
            metadata["conditions"] = {
                condition: {
                    "median_ms": statistics.median(row["prepare_ms"] for row in records if row["name"].endswith(condition)),
                    "range_ms": [min(row["prepare_ms"] for row in records if row["name"].endswith(condition)), max(row["prepare_ms"] for row in records if row["name"].endswith(condition))],
                    "max_rss_bytes": max(row["peak_rss_bytes"] for row in records if row["name"].endswith(condition)),
                } for condition in ("new", "warm", "changed")
            }
            metadata["target_met"] = all(row["prepare_ms"] < 1000 and row["peak_rss_bytes"] < 256 * 1024 * 1024 for row in records)
        (output / "summary.json").write_text(json.dumps(metadata, indent=2, sort_keys=True) + "\n")
    print(json.dumps({"evidence": str(output), "passed": passed, "target_met": metadata.get("target_met")}, sort_keys=True))
    return 0 if metadata.get("target_met") else 1


if __name__ == "__main__":
    sys.exit(main())
