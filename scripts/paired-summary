#!/usr/bin/env python3
"""Summarize frozen-driver output directories and compare two tools pairwise.

Reads every */trial.json under each given directory. Prints per-tool counts
and an exact two-sided sign test on paired per-question outcomes. Standard
library only; makes no model calls.
"""
import argparse
import json
import math
import statistics
import sys
from collections import defaultdict
from pathlib import Path


def load_trials(directories):
    trials = []
    for directory in directories:
        for path in sorted(Path(directory).glob('*/trial.json')):
            trial = json.loads(path.read_text())
            trial['_source_dir'] = str(directory)
            trial['_label'] = f"{Path(directory).name}:{trial['tool']}"
            trials.append(trial)
    return trials


def median(values):
    values = [v for v in values if isinstance(v, (int, float))]
    return statistics.median(values) if values else None


def per_tool(trials):
    groups = defaultdict(list)
    single = len({trial['_source_dir'] for trial in trials}) == 1
    for trial in trials:
        groups[(trial['tool'] if single else trial['_label'], trial['mode'])].append(trial)
    report = {}
    for (tool, mode), rows in sorted(groups.items()):
        positives = [r for r in rows if r['metrics']['positive']]
        negatives = [r for r in rows if not r['metrics']['positive']]
        with_leads = [r for r in positives if r['parsed'].get('leads')]
        required = sum(r['metrics']['required_spans'] for r in positives)
        covered = sum(r['metrics']['all_returned_covered_spans'] for r in positives if not r['metrics']['execution_or_integrity_error'])
        report[f'{tool}/{mode}'] = dict(
            trials=len(rows),
            positive_trials=len(positives),
            complete_positives=sum(r['metrics']['error_free_all_returned_source_all_required'] for r in positives),
            strict_hits_at_8=sum(r['metrics']['strict_hit_at_8'] for r in positives),
            span_recall=dict(covered=covered, required=required,
                             rate=(covered / required) if required else None),
            lead_inclusive_hits=dict(
                hits=sum(r['metrics']['lead_path_hit_at_8'] for r in with_leads),
                trials_with_leads=len(with_leads)),
            negatives=len(negatives),
            negative_source_records=sum(r['metrics']['negative_source_false_positive']
                                        for r in negatives),
            error_trials=sum(r['metrics']['execution_or_integrity_error'] for r in rows),
            median_requests=median([r['parsed'].get('requests') for r in rows]),
            median_user_output_bytes=median([r['parsed'].get('user_output_bytes') for r in rows]),
            median_wall_seconds=median([r['process'].get('wall_seconds') for r in rows]))
    return report


def sign_test(wins, losses):
    """Exact two-sided binomial sign test, p = P(|X - n/2| >= observed)."""
    n = wins + losses
    if n == 0:
        return None
    tail = sum(math.comb(n, i) for i in range(0, min(wins, losses) + 1)) / 2 ** n
    return min(1.0, 2 * tail)


def recall(trial):
    required = trial['metrics']['required_spans']
    if not required:
        return None
    if trial['metrics']['execution_or_integrity_error']:
        return 0.0
    return trial['metrics']['all_returned_covered_spans'] / required


def paired(trials, left, right):
    pairs = defaultdict(dict)
    for trial in trials:
        key = (trial['id'], trial['mode'], trial['repeat'])
        for name in (trial['tool'], trial['_label']):
            pairs[key].setdefault(name, trial)
    outcome = lambda t: 1 if t['metrics']['error_free_all_returned_source_all_required'] else 0
    strict = dict(wins=0, losses=0, ties=0, unpaired=0, error_pairs=0)
    span = dict(wins=0, losses=0, ties=0, unpaired=0, error_pairs=0)
    for pair in pairs.values():
        if left not in pair or right not in pair or pair[left] is pair[right]:
            strict['unpaired'] += 1
            continue
        a, b = pair[left], pair[right]
        if not a['metrics']['positive']:
            continue
        if a['metrics']['execution_or_integrity_error'] or b['metrics']['execution_or_integrity_error']:
            strict['error_pairs'] += 1
            span['error_pairs'] += 1
        delta = outcome(a) - outcome(b)
        strict['wins' if delta > 0 else 'losses' if delta < 0 else 'ties'] += 1
        ra, rb = recall(a), recall(b)
        if ra is not None and rb is not None:
            delta = ra - rb
            span['wins' if delta > 0 else 'losses' if delta < 0 else 'ties'] += 1
    return dict(tools=[left, right],
                complete=dict(strict, sign_test_p=sign_test(strict['wins'], strict['losses'])),
                span_recall=dict(span, sign_test_p=sign_test(span['wins'], span['losses'])))


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('directories', nargs='+', type=Path)
    parser.add_argument('--tools', default='blink,jg',
                        help='The two sides to pair, comma-separated: tool names or DIRNAME:tool labels')
    args = parser.parse_args(argv)
    trials = load_trials(args.directories)
    if not trials:
        parser.error('no trial.json files found')
    left, right = args.tools.split(',')
    print(json.dumps(dict(per_tool=per_tool(trials),
                          paired=paired(trials, left, right)),
                     indent=2, sort_keys=True))
    return 0


if __name__ == '__main__':
    sys.exit(main())
